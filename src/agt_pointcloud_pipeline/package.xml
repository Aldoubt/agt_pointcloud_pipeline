<?xml version="1.0"?>
<package format="3">
  <name>agt_pointcloud_pipeline</name>
  <version>0.1.0</version>
  <description>ROS 2 plugin-based runtime for AGT point cloud preprocessing.</description>
  <maintainer email="xuanyang.robotics@gmail.com">Xuan Yang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>agt_pointcloud_core</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>pluginlib</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
